{
    "name": "gizburdt/talk",
    "description": "Send notifications to recipients",
    "keywords": [
        "laravel",
        "notification"
    ],
    "homepage": "https://github.com/gizburdt/talk",
    "license": "MIT",
    "authors": [
        {
            "name": "Gijs Jorissen",
            "homepage": "https://gijsjorissen.nl",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/http": "^12.0||^13.0",
        "illuminate/notifications": "^12.0||^13.0",
        "illuminate/support": "^12.0||^13.0"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^11.2",
        "pestphp/pest": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Gizburdt\\Talk\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Gizburdt\\Talk\\Test\\": "tests"
        }
    },
    "scripts": {
        "format": "vendor/bin/pint",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    }
}
